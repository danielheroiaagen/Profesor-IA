# Profesor IA local configuration
# Copy this file to .env and replace placeholder values locally.
# Never commit real API keys, client secrets, SDP payloads, or provider responses.

# Required: server-only primary OpenAI key used to mint ephemeral Realtime credentials.
OPENAI_API_KEY="replace-with-your-openai-api-key"

# Optional: defaults to gpt-realtime-2 when omitted.
OPENAI_REALTIME_MODEL="gpt-realtime-2"

# Optional for the voice MVP: enables HeyGen avatar availability checks server-side.
HEYGEN_API_KEY=""

# Optional: defaults to the validated tutor avatar ID when omitted.
HEYGEN_AVATAR_ID="552426f4e4584a24871c5ffad2a97f73"
